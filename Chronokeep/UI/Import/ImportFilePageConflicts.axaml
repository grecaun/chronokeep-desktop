<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Chronokeep.UI.Import.ImportFilePageConflicts">
    <Grid Margin="0,0,10,0" RowDefinitions="Auto,1*">
        <StackPanel>
            <TextBlock
                Text="Select entries to keep."
                       FontSize="16"
                       Margin="0,0,0,5"
                       VerticalAlignment="Center"
                       TextAlignment="Center"/>
            <Grid Margin="10,5" ColumnDefinitions="50,30,50,*,*,50,50">
                <TextBlock Text="Old" Grid.Column="1"/>
                <TextBlock Text="Bib" Grid.Column="2"/>
                <TextBlock Text="Dist" Grid.Column="3"/>
                <TextBlock Text="Name" Grid.Column="4"/>
                <TextBlock Text="Gender" Grid.Column="5"/>
                <TextBlock Text="Age" Grid.Column="6"/>
            </Grid>
        </StackPanel>
        <ListBox Grid.Row="1"
                 Name="MultiplesListBox"
                 KeyboardNavigation.TabNavigation="Continue"
                 IsTabStop="False">
        </ListBox>
    </Grid>
</UserControl>
