<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Chronokeep.UI.MinWindow"
        Background="{DynamicResource PrimaryBackground}"
        WindowStartupLocation="CenterScreen"
        Title="Chronokeep"
        Height="700"
        Width="1320"
        MinHeight="600"
        MinWidth="800"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        PropertyChanged="Window_PropertyChanged"
        >
    <Grid RowDefinitions="auto,*">
        <Border Grid.Row="0"
                Background="Transparent"
                WindowDecorationProperties.ElementRole="TitleBar"
                PointerPressed="OnTitleBarPointerPressed"
                DoubleTapped="OnTitleBarDoubleTapped"
                Name="ChronokeepToolBar"
                >
            <DockPanel Margin="0">
               <StackPanel DockPanel.Dock="Right"
                           Orientation="Horizontal"
                           HorizontalAlignment="Right">
                    <Button WindowDecorationProperties.ElementRole="MinimizeButton"
                            Name="MinimizeButton"
                            Click="OnMinimize"
                            Classes="title">
                       <PathIcon Classes="title"
                                 Data="{OnPlatform Linux={StaticResource minimize_linux_regular}, Default={StaticResource minimize_win_regular}}"
                                 />
                    </Button>
                    <Button WindowDecorationProperties.ElementRole="MaximizeButton"
                            Name="MaximizeButton"
                            Click="OnMaximize"
                            Classes="title">
                        <Panel>   
                            <PathIcon Name="MaximizeIcon"
                                      Classes="title"
                                      Data="{OnPlatform Linux={StaticResource maximize_linux_regular}, Default={StaticResource maximize_win_regular}}"
                                      IsVisible="True"/>
                            <PathIcon Name="UnMaximizeIcon"
                                      Classes="title"
                                      Data="{OnPlatform Linux={StaticResource unmaximize_linux_regular}, Default={StaticResource unmaximize_win_regular}}"
                                      IsVisible="False"/>
                        </Panel>
                    </Button>
                    <Button WindowDecorationProperties.ElementRole="CloseButton"
                            Name="CloseButton"
                            Click="OnClose"
                            Classes="title close">
                    <PathIcon Classes="title"
                              Data="{OnPlatform Linux={StaticResource close_linux_regular}, Default={StaticResource close_win_regular}}"
                              />
                   </Button>
               </StackPanel>
            </DockPanel>
        </Border>
        <Grid RowDefinitions="auto,*" Margin="0" Grid.Row="1" VerticalAlignment="Stretch">
		    <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" Margin="{OnPlatform Default='0,10,0,0', Windows='0'}">
                <TextBlock Name="EventName" Grid.Column="0" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Name="EventDate" Grid.Column="3" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Button Grid.Column="1"
                        Name="NewEvent"
                        Content="New Event"
                        Click="NewEvent_Click"
                        Height="40"
                        FontSize="16"
                        Margin="15,0"
                        HorizontalAlignment="Stretch"
                        VerticalContentAlignment="Center"/>
                <Button Grid.Column="2"
                        Name="ChangeEvent"
                        Content="Change Event"
                        Click="ChangeEvent_Click"
                        Height="40"
                        FontSize="16"
                        Margin="15,0"
                        HorizontalAlignment="Stretch"
                        VerticalContentAlignment="Center"/>
            </Grid>
            <UserControl Grid.Row="1" Name="TheFrame" Margin="6,0" VerticalAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>

