<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Chronokeep.UI.Parts"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="450"
             x:Class="Chronokeep.UI.Parts.WavePart">
    <UserControl.Styles>
		<Style Selector="TextBlock">
			<Setter Property="FontSize" Value="14"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>
    <DockPanel VerticalAlignment="Center">
        <TextBlock Name="WaveName" Width="60"/>
        <Button Name="WavePlus"
                Click="SwapWaveType_Click"
                Width="35"
                Margin="0,0,3,0"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <Grid>
                <PathIcon Data="{StaticResource add_regular}" Name="PlusIcon" x:DataType="local:WavePart"/>
                <PathIcon Data="{StaticResource subtract_regular}" Name="MinusIcon" x:DataType="local:WavePart"/>
            </Grid>
        </Button>
        <MaskedTextBox Name="StartOffset"
                       GotFocus="SelectAll"
                       Mask="00:00:00.000"
                       FontSize="14"
                       VerticalContentAlignment="Center"
                       HorizontalContentAlignment="Center"/>
    </DockPanel>
</UserControl>

