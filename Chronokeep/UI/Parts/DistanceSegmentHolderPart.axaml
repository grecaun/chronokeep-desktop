<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="450"
             x:Class="Chronokeep.UI.Parts.DistanceSegmentHolderPart">
    <UserControl.Styles>
		<Style Selector="TextBlock.TeBlock">
            <Setter Property="Margin" Value="2,5,2,2"/>
			<Setter Property="FontSize" Value="14"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>
    <StackPanel IsTabStop="False">
	    <Grid ColumnDefinitions="*,50,50,auto">
		    <TextBlock Name="DistanceName"
		               FontSize="20"
		               Margin="10,5,0,5"
		               VerticalAlignment="Center"
		               Classes="TeBlock"
		               Grid.Column="0"/>
            <TextBox Name="NumAdd"
                     Text="1"
                     FontSize="16"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"
                     HorizontalAlignment="Center"
                     Width="40"
                     Height="35"
                     TextInput="NumberValidation"
                     Margin="2,5,2,2"
                     Grid.Column="1"/>
            <Button Name="AddButton"
                    FontSize="16"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="40"
                    Height="35"
                    Click="AddClick"
                    Grid.Column="2">
                <PathIcon Data="{StaticResource add_regular}"/>
            </Button>
            <DockPanel Name="CopyPanel" Grid.Column="3" LastChildFill="True">
			    <TextBlock Text="Copy from"
                           FontSize="14"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Classes="TeBlock"
                           Margin="10,0,2,0"
                           />
                <ComboBox Name="CopyFromDistance"
                          FontSize="14"
                          Height="35"
                          Width="150"
                          VerticalAlignment="Center"
                          VerticalContentAlignment="Center"
                          Margin="0,0,10,0"
                          SelectionChanged="CopyFromDistanceSelected"
                          />
            </DockPanel>
        </Grid>
        <Rectangle HorizontalAlignment="Stretch"
                   VerticalAlignment="Center"
                   Margin="5,0"
                   Height="1"
                   Fill="Gray"/>
    </StackPanel>
</UserControl>

