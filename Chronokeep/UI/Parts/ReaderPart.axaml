<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Chronokeep.UI.Parts.ReaderPart">
    <Grid VerticalAlignment="Center"
		  HorizontalAlignment="Center" ColumnDefinitions="140,120,50,130,50,50,50,50,50,50">
	    <ComboBox Grid.Column="0"
	              Name="ReaderType"
	              SelectionChanged="ReaderType_SelectionChanged"
	              Margin="2"
	              Height="40"
	              HorizontalAlignment="Stretch"
	              VerticalContentAlignment="Center"/>
		<TextBox Grid.Column="1"
		    Name="ReaderIp"
		    GotFocus="SelectAll"
			TextInput="IpValidation"
			Text=""
			Margin="2"
			Height="40"
			FontSize="14"
			VerticalAlignment="Center"
			HorizontalAlignment="Stretch"
			VerticalContentAlignment="Center"/>
		<TextBox Grid.Column="2"
			Name="ReaderPort"
			GotFocus="SelectAll"
			TextInput="NumberValidation"
			Text=""
			Margin="2"
			Height="40"
			FontSize="14"
			VerticalAlignment="Center"
			HorizontalAlignment="Stretch"
			VerticalContentAlignment="Center"/>
		<ComboBox Grid.Column="3"
			Name="ReaderLocation"
			Margin="2"
			Height="40"
			HorizontalAlignment="Stretch"
			VerticalContentAlignment="Center"/>
		<Button Grid.Column="4"
			Name="ClockButton"
			Click="Clock_Click"
			Margin="2"
			Height="40"
			Opacity="0.2"
			IsEnabled="False"
			HorizontalAlignment="Stretch"
			VerticalContentAlignment="Center">
			<PathIcon Data="{StaticResource clock_regular}"/>
		</Button>
		<Button Grid.Column="5"
			Name="RewindButton"
			Click="Rewind_Click"
			Margin="2"
			Height="40"
			Opacity="0.2"
			IsEnabled="False"
			HorizontalAlignment="Stretch"
			VerticalContentAlignment="Center">
			<PathIcon Data="{StaticResource rewind_regular}"/>
		</Button>
		<Button Grid.Column="6"
		    Name="SettingsButton"
			Click="Settings_Click"
			Margin="2"
			Height="40"
			Opacity="0.2"
			IsEnabled="False"
			HorizontalAlignment="Stretch"
			VerticalContentAlignment="Center">
			<PathIcon Data="{StaticResource settings_regular}"/>
		</Button>
		<Button Grid.Column="7"
		    Name="ReaderButton"
			Click="Readers_Click"
			Margin="2"
			Height="40"
			Opacity="0.2"
			IsEnabled="False"
			HorizontalAlignment="Stretch"
			VerticalContentAlignment="Center">
			<PathIcon Data="{StaticResource alert_regular}"/>
		</Button>
		<Button Grid.Column="8"
			Name="ConnectButton"
			Click="Connect_Click"
			Margin="2"
			Height="40"
			HorizontalAlignment="Stretch"
			VerticalContentAlignment="Center">
			<PathIcon Data="{StaticResource play_regular}"/>
		</Button>
		<Button Grid.Column="9"
			Name="RemoveButton"
			Click="Remove_Click"
			Margin="2"
			Height="40"
			IsVisible="False"
			HorizontalAlignment="Stretch"
			VerticalContentAlignment="Center">
			<PathIcon Data="{StaticResource delete_regular}"/>
		</Button>
    </Grid>
</UserControl>

