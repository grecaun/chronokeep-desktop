<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="400"
        x:Class="Chronokeep.UI.EventWindows.NewEventWindow"
        Background="{DynamicResource PrimaryBackground}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        SizeToContent="Height"
        Width="400"
        Topmost="True"
        >
    <Window.Styles>
       <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="10"/> 
       </Style> 
    </Window.Styles>
    <Grid RowDefinitions="auto,*">
        <Border Grid.Row="0"
                Background="Transparent"
                WindowDecorationProperties.ElementRole="TitleBar"
                PointerPressed="OnTitleBarPointerPressed"
                DoubleTapped="OnTitleBarDoubleTapped"
                Name="ChronokeepToolBar"
                >
            <DockPanel Margin="0">
               <StackPanel DockPanel.Dock="Right"
                           Orientation="Horizontal"
                           HorizontalAlignment="Right">
                    <Button WindowDecorationProperties.ElementRole="CloseButton"
                            Name="CloseButton"
                            Click="OnClose"
                            Classes="title close">
                    <PathIcon Classes="title"
                              Data="{OnPlatform Linux={StaticResource close_linux_regular}, Default={StaticResource close_win_regular}}"
                              />
                   </Button>
               </StackPanel> 
            </DockPanel>
        </Border>
        <StackPanel Margin="5" Grid.Row="1">
            <DockPanel Margin="10,0,10,0">
                <TextBlock Text="Name"
                           Margin="10,10,5,10"
                           FontSize="16"
                           Width="80"
                           TextAlignment="Right"
                           VerticalAlignment="Center"/>
                <TextBox Name="NameBox"
                         FontSize="16"
                         Margin="5,10,10,10"
                         TextWrapping="Wrap"
                         KeyUp="Keyboard_Up"/>
            </DockPanel>
            <DockPanel Margin="10,0,10,0">
                <TextBlock Text="Year Code"
                           Margin="10,10,5,10"
                           FontSize="16"
                           Width="80"
                           TextAlignment="Right"
                           VerticalAlignment="Center"/>
                <TextBox Name="YearCodeBox"
                         FontSize="16"
                         Margin="5,10,10,10"
                         KeyUp="Keyboard_Up"/>
            </DockPanel>
            <DockPanel Margin="10,0,10,0">
                <TextBlock Text="Date"
                           Margin="10,10,5,10"
                           FontSize="16"
                           Width="80"
                           TextAlignment="Right"
                           VerticalAlignment="Center"/>
                <CalendarDatePicker Name="DatePicker"
                                    KeyUp="Keyboard_Up"
                                    Margin="5,10,10,10"
                                    FontSize="16"/>
            </DockPanel>
            <AutoCompleteBox Name="OldEvent"
                             FontSize="16"
                             Width="250"
                             HorizontalAlignment="Center"
                             Margin="20,10,20,10"
                             PlaceholderText="Copy from old event?"
                             FilterMode="Contains"
                             >
                <AutoCompleteBox.InnerLeftContent>
                   <PathIcon Data="{StaticResource search_regular}" Margin="7"/> 
                </AutoCompleteBox.InnerLeftContent>
            </AutoCompleteBox>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button Content="Submit"
                        Click="Submit_Click"
                        Margin="20,10,10,15"
                        Width="120"
                        FontSize="16"
                        Height="35"/>
                <Button Content="Cancel"
                        Click="Cancel_Click"
                        Margin="10,10,20,15"
                        Width="120"
                        FontSize="16"
                        Height="35"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
