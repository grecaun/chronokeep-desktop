<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Chronokeep.UI.UhfRfidReader.ChipPersonWindow"
        Background="{DynamicResource PrimaryBackground}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        KeyUp="Window_KeyUp"
        Topmost="True"
        Closing="Window_Closing"
        >
    <Grid RowDefinitions="32,*">
        <Border Grid.Row="0"
                Background="Transparent"
                WindowDecorationProperties.ElementRole="TitleBar"
                PointerPressed="OnTitleBarPointerPressed"
                DoubleTapped="OnTitleBarDoubleTapped"
                >
            <DockPanel Margin="0">
               <StackPanel DockPanel.Dock="Right"
                           Orientation="Horizontal"
                           HorizontalAlignment="Right">
                    <Button WindowDecorationProperties.ElementRole="CloseButton"
                            Name="CloseButton"
                            Click="OnClose"
                            Classes="title close">
                    <PathIcon Classes="title"
                              Data="{OnPlatform Linux={StaticResource close_linux_regular}, Default={StaticResource close_win_regular}}"
                              />
                   </Button>
               </StackPanel> 
            </DockPanel>
        </Border>
        <TextBlock Grid.Row="1"
                   Name="Unknown"
                   FontSize="60"
                   IsVisible="False"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
        <StackPanel Grid.Row="1"
                    Name="InfoHolder"
                    VerticalAlignment="Center">
            <TextBlock Name="Bib"
                       FontSize="20"
                       HorizontalAlignment="Center"/>
            <TextBlock Name="Chip"
                       FontSize="20"
                       HorizontalAlignment="Center"/>
            <TextBlock Name="PersonName"
                       FontSize="60"
                       HorizontalAlignment="Center"/>
            <TextBlock Name="AgeGender"
                       FontSize="60"
                       HorizontalAlignment="Center"/>
            <TextBlock Name="Distance"
                       FontSize="60"
                       Margin="0,0,0,40"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
