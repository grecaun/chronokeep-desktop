<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Chronokeep.UI.ChipAssignment.BibChipAssociationWindow"
        Background="{DynamicResource PrimaryBackground}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="{OnPlatform Default='Full', Windows='BorderOnly'}"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height"
        Topmost="True"
        Closing="Window_Closing"
        >
    <Grid RowDefinitions="32,auto,*,auto">
        <Border Grid.Row="0"
                Background="Transparent"
                WindowDecorationProperties.ElementRole="TitleBar"
                PointerPressed="OnTitleBarPointerPressed"
                DoubleTapped="OnTitleBarDoubleTapped"
                IsVisible="{OnPlatform Default='False', Windows='True'}"
                Height="{OnPlatform Default='0', Windows='32'}">
            <DockPanel Margin="0">
               <StackPanel DockPanel.Dock="Right"
                           Orientation="Horizontal"
                           HorizontalAlignment="Right">
                    <Button WindowDecorationProperties.ElementRole="CloseButton"
                            Name="CloseButton"
                            Click="OnClose"
                            Classes="title close">
                    <PathIcon Classes="title"
                              Data="{OnPlatform Linux={StaticResource close_linux_regular}, Default={StaticResource close_win_regular}}"
                              />
                   </Button>
               </StackPanel> 
            </DockPanel>
        </Border>
        <StackPanel Name="SheetsContainer"
                    Grid.Row="1"
                    HorizontalAlignment="Center">
            <TextBlock Text="Please choose a sheet:"
                       FontSize="18"
                       Margin="10,10,10,5"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>
            <ComboBox Name="SheetsBox"
                      SelectionChanged="SheetsBox_SelectionChanged"
                      TabIndex="1"
                      Margin="5"
                      HorizontalAlignment="Stretch"/>
        </StackPanel>
        <ListBox Grid.Row="2"
                 Name="HeaderListBox"
                 Margin="20,3"
                 KeyboardNavigation.TabNavigation="Continue"></ListBox>
        <StackPanel Grid.Row="3">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,10">
                <ToggleSwitch
                    Name="Headers"
                    IsChecked="True"
                    FontSize="15"
                    OnContent=""
                    OffContent=""
                    Margin="0,-7,-7,-7"
                    HorizontalAlignment="Center"
                    VerticalContentAlignment="Center"
                    />
                <Label Content="First Row Contains Headers"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        Margin="0,5,0,10"
                        HorizontalAlignment="Center">
                <Button Name="Done"
                        Click="Done_Click"
                        Height="37"
                        Width="125"
                        Content="Done"
                        Margin="25,0,5,0"
                        HorizontalAlignment="Left"/>
                <Button Name="Cancel"
                        Click="Cancel_Click"
                        Height="37"
                        Width="125"
                        Content="Cancel"
                        Margin="5,0,25,0"
                        HorizontalAlignment="Right"
                        />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
