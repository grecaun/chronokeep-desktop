<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Chronokeep.UI.ChipAssignment.Parts.TagRangePart"
             IsTabStop="False">
    <Grid ColumnDefinitions="*,*,*,*,50">
	    <TextBox Name="StartBib"
	             Grid.Column="0"
	             Margin="5"
	             VerticalContentAlignment="Center"
	             GotFocus="SelectAll"
	             KeyDown="KeyPressHandler"
	             TextChanged="StartBib_TextChanged"/>
        <TextBox Name="EndBib"
                 Grid.Column="1"
                 Margin="5"
                 VerticalContentAlignment="Center"
                 GotFocus="SelectAll"
                 KeyDown="KeyPressHandler"
                 TextChanged="EndBib_TextChanged"/>
        <TextBox Name="StartChip"
                 Grid.Column="2"
                 Margin="5"
                 VerticalContentAlignment="Center"
                 GotFocus="SelectAll"
                 KeyDown="KeyPressHandler"
                 TextChanged="StartChip_TextChanged"/>
        <TextBlock Name="EndChip"
                   Grid.Column="3"
                   Margin="10,5,5,5"
                   VerticalAlignment="Center"/>
        <Button Name="Remove"
                Grid.Column="4"
                Click="Remove_Click"
                Height="35"
                HorizontalAlignment="Center">
            <PathIcon Data="{StaticResource delete_regular}"/>
        </Button>
    </Grid>
</UserControl>
