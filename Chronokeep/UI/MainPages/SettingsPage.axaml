<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="750"
             x:Class="Chronokeep.UI.MainPages.SettingsPage"
             Padding="16"
             Background="{DynamicResource PrimaryBackground}"
             CornerRadius="8,0,0,0"
             >
    <UserControl.Styles>
        <Style Selector="Button.setting">
            <Setter Property="Margin" Value="10,0,10,5"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="175"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.setting_two">
            <Setter Property="Margin" Value="0,0,10,5"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="TextBlock.settings">
			<Setter Property="Width" Value="170"/>
			<Setter Property="Margin" Value="10,0,10,5"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.settings">
			<Setter Property="Margin" Value="0,0,10,5"/>
			<Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
        <Style Selector="Slider">
			<Setter Property="Margin" Value="0,0,10,0"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="IsSnapToTickEnabled" Value="True"/>
			<Setter Property="TickFrequency" Value="5"/>
			<Setter Property="Minimum" Value="5"/>
			<Setter Property="Maximum" Value="60"/>
        </Style>
        <Style Selector="StackPanel.toggle">
			<Setter Property="Margin" Value="10,0,10,5"/>
			<Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="StackPanel.toggle Label">
			<Setter Property="Margin" Value="10,0,0,0"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="HorizontalAlignment" Value="Left"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="ToggleSwitch">
			<Setter Property="OffContent" Value=""/>
			<Setter Property="OnContent" Value=""/>
			<Setter Property="Margin" Value="0,-7"/>
            <Setter Property="Width" Value="40"/>
        </Style>
        <Style Selector="ComboBox">
			<Setter Property="Margin" Value="0,0,10,5"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ComboBox ComboBoxItem">
			<Setter Property="Margin" Value="0"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="1*,1*,1*">
            <Button
                Grid.Column="0"
                Name="ResetDb"
                Content="Reset Database"
                Click="ResetDB_Click"
                Classes="setting"
            />
            <Button
                Grid.Column="1"
                Name="RebuildDb"
                Content="Rebuild Database"
                Click="RebuildDB_Click"
                Classes="setting"
                />
            <Button
                Grid.Column="2"
                Name="Save"
                Content="Save"
                Click="Save_Click"
                Classes="setting"
                />
        </Grid>
        <Grid Grid.Row="1" Margin="10" ColumnDefinitions="4*,300">
            <ScrollViewer VerticalScrollBarVisibility="Visible"
                          Padding="5,0,5,5">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="Company Name"
                                   Classes="settings"/>
                        <TextBox Name="CompanyNameBox"
                                 Classes="settings"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="Contact Email"
                                   Classes="settings"/>
                        <TextBox Name="ContactEmailBox"
                                 Classes="settings"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="Default Timing System"
                                   Classes="settings"/>
                        <ComboBox Name="DefaultTimingBox"
                                  Classes="settings"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="Theme Color"
                                   Classes="settings"/>
                        <ComboBox Name="ThemeColorBox"
                                  SelectionChanged="ThemeColorBox_SelectionChanged" />
                    </DockPanel>
                    <Grid ColumnDefinitions="190,1*,100">
                        <TextBlock Text="Export Directory"
                                   Grid.Column="0"
                                   Classes="settings"/>
                        <TextBox Name="DefaultExportDirBox"
                                 Grid.Column="1"
                                 Classes="settings"/>
                        <Button Grid.Column="2"
                                Name="ChangeExport"
                                Content="Change"
                                Classes="setting_two"
                                Click="ChangeExport_Click" />
                    </Grid>
                    <Grid Margin="0,-5,0,0" ColumnDefinitions="190,*,40">
                        <TextBlock Text="Upload Interval"
                                   Grid.Column="0"
                                   Classes="settings"/>
                        <Slider Grid.Column="1"
                                Name="UploadSlider"
                                ValueChanged="UploadSlider_ValueChanged" />
                        <TextBlock Grid.Column="2"
                                   Name="UploadBlock"
                                   Width="30"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Classes="settings"/>
                    </Grid>
                    <Grid Margin="0,-10" ColumnDefinitions="190,*,40">
                        <TextBlock Text="Download Interval"
                                   Classes="settings"/>
                        <Slider Grid.Column="1"
                                Name="DownloadSlider"
                                ValueChanged="DownloadSlider_ValueChanged" />
                        <TextBlock Grid.Column="2"
                                   Name="DownloadBlock"
                                   Width="30"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Classes="settings"/>
                    </Grid>
                    <Grid ColumnDefinitions="190,*,40">
                        <TextBlock Text="Announcer Window"
                                   Classes="settings"/>
                        <Slider Grid.Column="1"
                                Name="AnnouncerSlider"
                                ValueChanged="AnnouncerSlider_ValueChanged"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"
                                TickFrequency="1"
                                Minimum="1"
                                Maximum="120"/>
                        <TextBlock Grid.Column="2"
                                   Name="AnnouncerBlock"
                                   Width="30"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Classes="settings"/>
                    </Grid>
                    <DockPanel>
                        <TextBlock Text="Alarm Sound"
                                   Classes="settings"/>
                        <Button Name="PlayBtn"
                                Content="Play"
                                Click="PlayBtn_Click"
                                Classes="setting_two"
                                Width="70"/>
                        <ComboBox Name="AlarmSoundBox">
                            <ComboBoxItem Content="Alert 1" />
                            <ComboBoxItem Content="Alert 2" />
                            <ComboBoxItem Content="Alert 3" />
                            <ComboBoxItem Content="Alert 4" />
                            <ComboBoxItem Content="Alert 5" />
                            <ComboBoxItem Content="Emily 1" />
                            <ComboBoxItem Content="Emily 2" />
                            <ComboBoxItem Content="Emily 3" />
                            <ComboBoxItem Content="Michael 1" />
                            <ComboBoxItem Content="Michael 2" />
                            <ComboBoxItem Content="Michael 3" />
                        </ComboBox>
                    </DockPanel>
                    <Grid ColumnDefinitions="190,*,105">
                        <TextBlock Grid.Column="0"
                                   Text="Program Identifier"
                                   Classes="settings"/>
                        <TextBox Grid.Column="1"
                                 Name="UniqueProgramId"
                                 HorizontalContentAlignment="Stretch"
                                 IsEnabled="False"/>
                        <Button Grid.Column="2"
                                Name="RegenerateUniqueProgramIdButton"
                                Content="Regenerate"
                                Classes="setting_two"
                                Click="RegenerateUniqueProgramIDButton_Click" />
                    </Grid>
                    <DockPanel>
                        <TextBlock Text="Registration Server Name"
                                   Classes="settings"/>
                        <TextBox Name="RegistrationServerNameBox"
                                 Classes="settings"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="Twilio Account SID"
                                   Classes="settings"/>
                        <TextBox Name="TwilioAccountSidBox"
                                 Classes="settings"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="Twilio Auth Token"
                                   Classes="settings"/>
                        <TextBox Name="TwilioAuthTokenBox"
                                 Classes="settings"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="Twilio Phone Number"
                                   Classes="settings"/>
                        <TextBox Name="TwilioPhoneNumberBox"
                                 Classes="settings"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="Mailgun From Name"
                                   Classes="settings"/>
                        <TextBox Name="MailgunFromNameBox"
                                 Classes="settings"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="Mailgun From Email"
                                   Classes="settings"/>
                        <TextBox Name="MailgunFromEmailBox"
                                 Classes="settings"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="Mailgun API Key"
                                   Classes="settings"/>
                        <TextBox Name="MailgunApiKeyBox"
                                 Classes="settings"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="Mailgun Domain"
                                   Classes="settings"/>
                        <TextBox Name="MailgunApiUrlBox"
                                 Classes="settings"/>
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Column="1">
                <StackPanel Orientation="Horizontal"
                            Classes="toggle">
                    <ToggleSwitch Name="UpdatePage"/>
                    <Label VerticalAlignment="Center">Auto-save changes</Label>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Classes="toggle">
                    <ToggleSwitch Name="ExitNoPrompt"/>
                    <Label VerticalAlignment="Center">Do not prompt before exit</Label>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Classes="toggle">
                    <ToggleSwitch Name="CheckUpdates"/>
                    <Label VerticalAlignment="Center">Check for updates</Label>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Classes="toggle">
                    <ToggleSwitch Name="AutoChangelog"/>
                    <Label VerticalAlignment="Center">Show changelog after update</Label>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

