<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="550"
             x:Class="Chronokeep.UI.MainPages.AgeGroupsPage"
             Padding="16"
             Background="{DynamicResource PrimaryBackground}"
             CornerRadius="8,0,0,0"
             >
    <Grid ColumnDefinitions="1*,150" RowDefinitions="auto,40,*,auto">
        <ComboBox Grid.Row="0"
                  Grid.Column="0"
                  Name="DistancesBox"
                  FontSize="16"
                  Margin="0,0,0,15"
                  Height="35"
                  Width="250"
                  SelectionChanged="Distances_SelectionChanged"
                  HorizontalAlignment="Center"
                  VerticalContentAlignment="Center"
                  IsVisible="False"/>
        <Grid Grid.Row="1" Grid.Column="0"
              MaxWidth="400"
              VerticalAlignment="Center" ColumnDefinitions="*,*,55">
            <TextBlock Grid.Column="0"
                       Text="Start Age"
                       FontSize="16"
                       Margin="10"
                       HorizontalAlignment="Center"
            />
            <TextBlock Grid.Column="1"
                       Text="End Age"
                       FontSize="16"
                       Margin="10"
                       HorizontalAlignment="Center"
                       />
        </Grid>
        <ListBox Grid.Row="2" Grid.Column="0"
                 Name="AgeGroupsBox"
                 CornerRadius="8"
                 KeyboardNavigation.TabNavigation="Continue"
                 />
        <DockPanel LastChildFill="False"
                   Grid.Row="3"
                   Grid.ColumnSpan="2" Grid.Column="0"
                   HorizontalAlignment="Center"
                   Margin="0"
                   >
            <Button Name="Add"
                    Content="Add Group"
                    Click="Add_Click"
                    Classes="mainpage"/>
            <Button Name="Save"
                    Content="Save"
                    Click="Update_Click"
                    Classes="mainpage"/>
            <Button Name="ResetBtn"
                    Content="Reset"
                    Click="Revert_Click"
                    Classes="mainpage"/>
        </DockPanel>
        <StackPanel Grid.Row="1" Grid.Column="1">
            <ComboBox Name="DefaultGroupsBox"
                      Height="35"
                      FontSize="16"
                      SelectedIndex="0"
                      Margin="10,100,10,10"
                      HorizontalAlignment="Stretch"
                      VerticalContentAlignment="Center"
                      HorizontalContentAlignment="Center">
                <ComboBoxItem Content="10 Years" Tag="1"/>
                <ComboBoxItem Content="5 Years" Tag="2"/>
                <ComboBoxItem Content="Under 40, Masters, Grand Masters" Tag="3"/>
                <ComboBoxItem Content="Abbott WMM" Tag="4"/>
            </ComboBox>
            <Button Content="Change"
                    Name="AddDefault"
                    Click="AddDefault_Click"
                    Height="35"
                    Width="150"
                    FontSize="16"
                    Margin="10,0"
                    HorizontalAlignment="Stretch"
                    />
        </StackPanel>
    </Grid>
</UserControl>
