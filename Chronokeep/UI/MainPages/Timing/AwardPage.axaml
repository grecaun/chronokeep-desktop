<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:objects="using:Chronokeep.Objects"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Chronokeep.UI.MainPages.Timing.AwardPage">
    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
        <Style Selector="TextBlock">
		    <Setter Property="Margin" Value="5,5,5,0"/>
		    <Setter Property="HorizontalAlignment" Value="Center"/>
		    <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style Selector="ToggleSwitch">
		    <Setter Property="OffContent" Value=""/>
		    <Setter Property="OnContent" Value=""/>
		    <Setter Property="FontSize" Value="12"/>
		    <Setter Property="VerticalAlignment" Value="Center"/>
		    <Setter Property="Margin" Value="0,-7,-15,-7"/>
        </Style>
        <Style Selector="Label">
		    <Setter Property="VerticalContentAlignment" Value="Center"/>
		    <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox">
			<Setter Property="Height" Value="35"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="MinWidth" Value="30"/>
        </Style>
        <Style Selector="ListBox">
			<Setter Property="SelectionMode" Value="Multiple"/>
			<Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="ListBoxItem">
           <Setter Property="Padding" Value="2"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SecondaryBackground}"/>
        </Style>
        <Style Selector="ListBoxItem:focus /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SecondaryBackground}"/>
        </Style>
        <Style Selector="ListBoxItem:pressed /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}"/>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="*,55">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.Row="0">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Distances" FontSize="16"/>
                <ListBox Name="DistancesBox" Margin="0,10,0,5" BorderThickness="1" BorderBrush="{DynamicResource ForegroundBrush}">
                    <ListBoxItem Content="All" IsSelected="True"/>
                </ListBox>
                <TextBlock Text="Overall" Margin="0,10"/>
                <DockPanel HorizontalAlignment="Left" Margin="0,0,0,5">
                    <ToggleSwitch Name="OverallYes" IsChecked="True"/>
                    <Label Content="Print" Margin="0,0,58,0"/>
                    <TextBox Text="3"
                             Name="OverallNumberParticipants"
                             TextInput="IsNumber"
                             Width="40"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <ToggleSwitch Name="OverallExcludeAg" IsChecked="False"/>
                    <Label Content="Exclude winners from Age Group awards." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <ToggleSwitch Name="OverallExcludeCustom" IsChecked="False"/>
                    <Label Content="Exclude winners from Custom awards." />
                </StackPanel>
                <TextBlock Text="Age Groups" Margin="0,5,0,10"/>
                <DockPanel HorizontalAlignment="Left" Margin="0,0,0,5">
                    <ToggleSwitch Name="AgYes" IsChecked="True"/>
                    <Label Content="Print" Margin="0,0,58,0"/>
                    <TextBox Name="AgNumberParticipants"
                             TextInput="IsNumber"
                             Text="3"
                             Width="40"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
					<ToggleSwitch Name="AgExcludeCustom" IsChecked="False"/>
                    <Label Content="Exclude winners from Custom awards."/>
                </StackPanel>
                <TextBlock Text="Custom" Margin="0,5,0,10"/>
                <DockPanel HorizontalAlignment="Left" Margin="0,0,0,5">
                    <ToggleSwitch Name="CustomYes" IsChecked="True"/>
                    <Label Content="Print" Margin="0,0,58,0"/>
                    <TextBox Name="CustomNumberParticipants"
                             TextInput="IsNumber"
                             DockPanel.Dock="Top"
                             Text="3"
                             Width="40"/>
                </DockPanel>
                <DataGrid Name="CustomGroupsListView" SelectionMode="Extended" Margin="0,0,0,5" CanUserResizeColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Start Age" Binding="{Binding StartAge}" Width="110" x:DataType="objects:AgeGroup"/>
                        <DataGridTextColumn Header="End Age" Binding="{Binding EndAge}" Width="110" x:DataType="objects:AgeGroup"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding CustomName}" Width="110" x:DataType="objects:AgeGroup"/>
                    </DataGrid.Columns>
                </DataGrid>
                <DockPanel HorizontalAlignment="Center" Margin="0,0,0,5">
                    <TextBox Width="100" Name="StartCustom" TextInput="IsNumber" Margin="0,0,2,0" HorizontalContentAlignment="Center" />
                    <TextBox Width="100" Name="EndCustom" TextInput="IsNumber" Margin="2,0" HorizontalContentAlignment="Center" />
                    <TextBox Width="100" Name="CustomNameBox" Margin="2,0,0,0" HorizontalContentAlignment="Center" />
                </DockPanel>
                <DockPanel HorizontalAlignment="Center" Margin="0,5,0,0">
                    <Button Name="AddCustom" Content="Add" Click="AddCustom_Click"/>
                    <Button Name="DeleteCustom" Content="Delete" Click="DeleteCustom_Click"/>
                </DockPanel>
            </StackPanel>
        </ScrollViewer>
        <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1">
            <Button Name="SaveButton" Content="Save" Click="SaveButton_Click"/>
            <Button Name="DoneButton" Content="Done" Click="DoneButton_Click"/>
        </DockPanel>
    </Grid>
</UserControl>

