<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Chronokeep.UI.Export.ExportResults"
        Background="{DynamicResource PrimaryBackground}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        WindowStartupLocation="CenterScreen"
        Title="Export Results"
        Height="450"
        Width="300"
        MaxWidth="300"
        MinWidth="300"
        Topmost="True"
        Closing="Window_Closing"
        PropertyChanged="Window_PropertyChanged"
        >
    <Grid RowDefinitions="32,30,*,55">
        <Border Grid.Row="0"
                Background="Transparent"
                WindowDecorationProperties.ElementRole="TitleBar">
            <DockPanel Margin="0">
               <StackPanel DockPanel.Dock="Right"
                           Orientation="Horizontal"
                           HorizontalAlignment="Right">
                    <Button WindowDecorationProperties.ElementRole="MinimizeButton"
                            Name="MinimizeButton"
                            Click="OnMinimize"
                            Classes="title">
                       <PathIcon Classes="title"
                                 Data="{OnPlatform Linux={StaticResource minimize_linux_regular}, Default={StaticResource minimize_win_regular}}"
                                 />
                    </Button>
                    <Button WindowDecorationProperties.ElementRole="MaximizeButton"
                            Name="MaximizeButton"
                            Click="OnMaximize"
                            Classes="title">
                        <Panel>   
                            <PathIcon Name="MaximizeIcon"
                                      Classes="title"
                                      Data="{OnPlatform Linux={StaticResource maximize_linux_regular}, Default={StaticResource maximize_win_regular}}"
                                      IsVisible="True"/>
                            <PathIcon Name="UnMaximizeIcon"
                                      Classes="title"
                                      Data="{OnPlatform Linux={StaticResource unmaximize_linux_regular}, Default={StaticResource unmaximize_win_regular}}"
                                      IsVisible="False"/>
                        </Panel>
                    </Button>
                    <Button WindowDecorationProperties.ElementRole="CloseButton"
                            Name="CloseButton"
                            Click="OnClose"
                            Classes="title close">
                    <PathIcon Classes="title"
                              Data="{OnPlatform Linux={StaticResource close_linux_regular}, Default={StaticResource close_win_regular}}"
                              />
                   </Button>
               </StackPanel> 
            </DockPanel>
        </Border>
        <TextBlock Grid.Row="1"
                   Text="Content to Export"
                   FontSize="16"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   Margin="0,-15,0,0"/>
        <ListBox Grid.Row="2"
                 Name="headersList"
                 Margin="5,0,5,5"
                 BorderThickness="0">
        </ListBox>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Name="Done"
                    Content="Submit"
                    Click="Done_Click"
                    FontSize="16"
                    Height="35"
                    Margin="10,5,5,10"
                    HorizontalAlignment="Stretch"/>
            <Button Grid.Column="1"
                    Name="Cancel"
                    Content="Cancel"
                    Click="Cancel_Click"
                    FontSize="16"
                    Height="35"
                    Margin="5,5,10,10"
                    HorizontalAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>
