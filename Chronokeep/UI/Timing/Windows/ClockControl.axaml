<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Chronokeep.UI.Timing.Windows.ClockControl"
        Background="{DynamicResource PrimaryBackground}"
        WindowStartupLocation="CenterScreen"
        Title="Remote Readers"
        CanResize="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Closed="Window_Closed"
        >
    <Grid RowDefinitions="auto,*">
        <Border Grid.Row="0"
                Background="Transparent"
                WindowDecorationProperties.ElementRole="TitleBar"
                PointerPressed="OnTitleBarPointerPressed"
                DoubleTapped="OnTitleBarDoubleTapped"
                Name="ChronokeepToolBar"
                >
            <DockPanel Margin="0">
               <StackPanel DockPanel.Dock="Right"
                           Orientation="Horizontal"
                           HorizontalAlignment="Right">
                    <Button WindowDecorationProperties.ElementRole="CloseButton"
                            Name="CloseButton"
                            Click="OnClose"
                            Classes="title close">
                    <PathIcon Classes="title"
                              Data="{OnPlatform Linux={StaticResource close_linux_regular}, Default={StaticResource close_win_regular}}"
                              />
                   </Button>
               </StackPanel> 
            </DockPanel>
        </Border>
        <StackPanel Margin="0" Grid.Row="1">
            <ListBox Name="ClockListView" Margin="25,0,25,10"/>
            <TextBlock Name="CurrentTimeLabel"
                       FontSize="14"
                       IsVisible="False"
                       Margin="10,0,10,5"
                       TextAlignment="Center"
                       VerticalAlignment="Center"/>
            <TextBlock Name="TimeLabel"
                       FontSize="14"
                       IsVisible="False"
                       Margin="10,5,10,10"
                       TextAlignment="Center"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Name="AddButton"
                        Content="Add Clock"
                        Click="AddButton_Click"
                        Width="150"
                        Height="35"
                        Margin="0,0,5,10"
                        HorizontalAlignment="Center"/>
                <Button Content="Close"
                        Click="Close_Click"
                        Width="150"
                        Height="35"
                        Margin="5,0,0,10"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>

