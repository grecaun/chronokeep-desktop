<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Chronokeep.UI.Timing.Windows.EditRawReadsWindow"
        Background="{DynamicResource PrimaryBackground}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        WindowStartupLocation="CenterScreen"
        Width="250"
        CanResize="False"
        SizeToContent="Height"
        Topmost="True"
        Closed="Window_Closed"
        PropertyChanged="Window_PropertyChanged"
        >
    <Grid RowDefinitions="32,*">
        <Border Grid.Row="0"
                Background="Transparent"
                WindowDecorationProperties.ElementRole="TitleBar">
            <DockPanel Margin="0">
               <StackPanel DockPanel.Dock="Right"
                           Orientation="Horizontal"
                           HorizontalAlignment="Right">
                    <Button WindowDecorationProperties.ElementRole="MinimizeButton"
                            Name="MinimizeButton"
                            Click="OnMinimize"
                            Classes="title">
                       <PathIcon Classes="title"
                                 Data="{OnPlatform Linux={StaticResource minimize_linux_regular}, Default={StaticResource minimize_win_regular}}"
                                 />
                    </Button>
                    <Button WindowDecorationProperties.ElementRole="MaximizeButton"
                            Name="MaximizeButton"
                            Click="OnMaximize"
                            Classes="title">
                        <Panel>   
                            <PathIcon Name="MaximizeIcon"
                                      Classes="title"
                                      Data="{OnPlatform Linux={StaticResource maximize_linux_regular}, Default={StaticResource maximize_win_regular}}"
                                      IsVisible="True"/>
                            <PathIcon Name="UnMaximizeIcon"
                                      Classes="title"
                                      Data="{OnPlatform Linux={StaticResource unmaximize_linux_regular}, Default={StaticResource unmaximize_win_regular}}"
                                      IsVisible="False"/>
                        </Panel>
                    </Button>
                    <Button WindowDecorationProperties.ElementRole="CloseButton"
                            Name="CloseButton"
                            Click="OnClose"
                            Classes="title close">
                    <PathIcon Classes="title"
                              Data="{OnPlatform Linux={StaticResource close_linux_regular}, Default={StaticResource close_win_regular}}"
                              />
                   </Button>
               </StackPanel> 
            </DockPanel>
        </Border>
        <Grid Margin="0" HorizontalAlignment="Center" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="95"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="0"
                       Grid.Row="1"
                       Text="Days"
                       FontSize="14"
                       TextAlignment="Center"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Grid.Row="1"
                       Text="Time"
                       FontSize="14"
                       TextAlignment="Center"
                       VerticalAlignment="Center"/>
            <TextBox Grid.Column="0"
                     Grid.Row="2"
                     Name="DaysBox"
                     KeyDown="Enter_KeyDown"
                     TextInput="DaysBox_PreviewTextInput"
                     FontSize="14"
                     Margin="5,5,5,5"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Center"/>
            <MaskedTextBox Grid.Column="1"
                           Grid.Row="2"
                           Name="TimeBox"
                           KeyDown="Enter_KeyDown"
                           FontSize="14"
                           Margin="5,5,5,5"
                           Mask="00:00:00.000"
                           VerticalContentAlignment="Center"
                           HorizontalContentAlignment="Center"/>
            <Grid Grid.Row="3" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <RadioButton Grid.Column="0"
                             Grid.Row="0"
                             Name="AddRadio"
                             Content="Add"
                             KeyDown="Enter_KeyDown"
                             GroupName="RadioGroup"
                             Margin="10,0,5,0"
                             IsChecked="True"/>
                <RadioButton Grid.Column="1"
                             Grid.Row="0"
                             Content="Subtract"
                             Name="SubRadio"
                             GroupName="RadioGroup"
                             KeyDown="Enter_KeyDown"
                             Margin="5,0,0,0"/>
                <Button Grid.Column="0"
                        Grid.Row="1"
                        Name="Submit"
                        Content="Submit"
                        Click="Submit_Click"
                        Width="100"
                        Height="35"
                        Margin="5,5,5,5"
                        HorizontalAlignment="Center"/>
                <Button Grid.Column="1"
                        Grid.Row="1"
                        Name="Cancel"
                        Content="Cancel"
                        Click="Cancel_Click"
                        Width="100"
                        Height="35"
                        Margin="5,5,5,5"
                        HorizontalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
