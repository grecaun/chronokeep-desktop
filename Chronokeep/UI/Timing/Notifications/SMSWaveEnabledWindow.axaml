<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="using:Chronokeep.UI.Timing.Notifications"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="230"
        x:Class="Chronokeep.UI.Timing.Notifications.SmsWaveEnabledWindow"
        Background="{DynamicResource PrimaryBackground}"
        WindowStartupLocation="CenterScreen"
        Title="SMS Waves"
        Width="230"
        SizeToContent="Height"
        Topmost="True"
        Closing="Window_Closing"
        >
    <Grid RowDefinitions="32,*,auto">
        <Border Grid.Row="0"
                Background="Transparent"
                WindowDecorationProperties.ElementRole="TitleBar"
                PointerPressed="OnTitleBarPointerPressed"
                DoubleTapped="OnTitleBarDoubleTapped"
                Name="ChronokeepToolBar"
                >
            <DockPanel Margin="0">
               <StackPanel DockPanel.Dock="Right"
                           Orientation="Horizontal"
                           HorizontalAlignment="Right">
                    <Button WindowDecorationProperties.ElementRole="CloseButton"
                            Name="CloseButton"
                            Click="OnClose"
                            Classes="title close">
                    <PathIcon Classes="title"
                              Data="{OnPlatform Linux={StaticResource close_linux_regular}, Default={StaticResource close_win_regular}}"
                              />
                   </Button>
               </StackPanel> 
            </DockPanel>
        </Border>
        <StackPanel Grid.Row="1" Name="MainPanel">
            <ListBox Name="WaveList"
                        Margin="15,0"
                        BorderThickness="0"
                        KeyboardNavigation.TabNavigation="Continue">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ToggleSwitch Name="SmsEnabledSwitch"
                                            DockPanel.Dock="Right"
                                            IsChecked="{Binding SmsEnabled}"
                                            Margin="0,-7"
                                            OnContent=""
                                            OffContent=""
                                            VerticalAlignment="Center"
                                            x:DataType="local:WaveSms"/>
                            <TextBlock Text="{Binding WaveName}" Margin="5" x:DataType="local:WaveSms"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        <StackPanel Grid.Row="2"
                    Margin="0,10,0,15"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button Name="Set"
                    Content="Set"
                    Click="Set_Click"
                    Width="100"
                    Height="35"
                    FontSize="14"
                    Margin="0,0,5,0"
                    HorizontalAlignment="Center"/>
            <Button Name="Done"
                    Content="Done"
                    Click="Done_Click"
                    Width="100"
                    Height="35"
                    FontSize="14"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
