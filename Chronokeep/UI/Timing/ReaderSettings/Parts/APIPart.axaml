<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="Chronokeep.UI.Timing.ReaderSettings.Parts.ApiPart">
    <StackPanel Orientation="Vertical"
                HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <TextBox Name="NameBox"
                     Width="170"
                     Margin="5"/>
            <ComboBox Name="KindBox"
                      Width="140"
                      Margin="5"
                      SelectionChanged="KindBox_ValueChanged">
                <ComboBoxItem Content="Remote" Tag="CHRONOKEEP_REMOTE"/>
                <ComboBoxItem Content="Remote Self" Tag="CHRONOKEEP_REMOTE_SELF"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <TextBox Name="TokenBox"
                     Width="320"
                     Margin="5"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <TextBox Name="UriBox"
                     Width="220"
                     Margin="5"/>
            <Button Width="40"
                    Height="35"
                    Margin="5"
                    Click="SaveApi">
			    <PathIcon Data="{StaticResource save_regular}"/>
            </Button>
            <Button Width="40"
                    Height="35"
                    Margin="5"
                    Click="DeleteApi">
			    <PathIcon Data="{StaticResource delete_regular}"/>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
