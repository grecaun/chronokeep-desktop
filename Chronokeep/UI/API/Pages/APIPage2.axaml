<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:chronokeepapi="using:Chronokeep.Objects.ChronoKeepAPI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Chronokeep.UI.API.Pages.ApiPage2">
    <UserControl.Styles>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
        </Style>
        <Style Selector="ListBoxItem:focus /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
        </Style>
        <Style Selector="ListBoxItem:pressed /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}"/>
        </Style>
    </UserControl.Styles>
    <StackPanel VerticalAlignment="Center" Margin="0,10,0,10">
        <TextBlock Name="HoldingLabel"
                   Text="Retrieving Events, Please Hold."
                   FontSize="18"
                   MaxWidth="300"
                   TextAlignment="Center"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"/>
        <StackPanel Name="EventPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="False"
                    Margin="5,0">
            <TextBlock Text="Select Event to link to:"
                       FontSize="16"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>
            <Grid VerticalAlignment="Center" ColumnDefinitions="46,234">
                <PathIcon Grid.Column="0"
                          Data="{StaticResource search_regular}"
                          Margin="20,0,10,10"
                          VerticalAlignment="Center"/>
                <TextBox Grid.Column="1"
                         Name="SearchBox"
                         PlaceholderText="Search..."
                         TextChanged="SearchBox_TextChanged"
                         Height="40"
                         Margin="5,0,15,15"
                         VerticalContentAlignment="Center"/>
            </Grid>
            <ListBox Name="EventList"
                     DoubleTapped="EventList_MouseDoubleClick"
                     SelectionChanged="EventBox_SelectionChanged"
                     MaxWidth="253"
                     MaxHeight="114"
                     Margin="4,0,4,5"
                     VerticalAlignment="Stretch"
                     HorizontalAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock Margin="8,4" Text="{Binding Name}" x:DataType="chronokeepapi:ApiEvent"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Name="NewPanel"
                        IsVisible="False">
                <TextBlock Text="New Event:"
                           FontSize="20"
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Center"
                           Margin="0,10,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Name"
                               FontSize="15"
                               Width="100"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               Padding="0,0,5,0"/>
                    <TextBox Name="NameBox"
                             FontSize="15"
                             Width="180"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Cert Name"
                               FontSize="15"
                               Width="100"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               Padding="0,0,5,0"/>
                    <TextBox Name="CertNameBox"
                             FontSize="15"
                             Width="180"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Slug" 
                               FontSize="15"
                               Width="100"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               Padding="0,0,5,0"/>
                    <TextBox Name="SlugBox"
                             FontSize="15"
                             Width="180"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Contact Email"
                               FontSize="15"
                               Width="100"
                               VerticalAlignment="Center" 
                               TextAlignment="Right"
                               Padding="0,0,5,0"/>
                    <TextBox Name="ContactBox"
                             FontSize="15" 
                             Width="180"
                             VerticalAlignment="Center" 
                             HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5" IsVisible="False">
                    <TextBlock Text="Website URL"
                               FontSize="15"
                               Width="100"
                               VerticalAlignment="Center" 
                               TextAlignment="Right"
                               Padding="0,0,5,0"/>
                    <TextBox Name="WebsiteBox"
                             FontSize="15" 
                             Width="180"
                             VerticalAlignment="Center" 
                             HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5" IsVisible="False">
                    <TextBlock Text="Image URL"
                               FontSize="15"
                               Width="100"
                               VerticalAlignment="Center" 
                               TextAlignment="Right"
                               Padding="0,0,5,0"/>
                    <TextBox Name="ImageBox"
                             FontSize="15" 
                             Width="180"
                             VerticalAlignment="Center" 
                             HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                    <ToggleSwitch Name="RestrictBox"
                                  VerticalContentAlignment="Center"
                                  HorizontalAlignment="Center"
                                  OffContent=""
                                  OnContent=""
                                  Margin="0,-7,0,-7"/>
                    <Label Content="Restrict Access" FontSize="15"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">
            <Button Content="Next"
                    Height="35"
                    Width="120"
                    VerticalAlignment="Bottom"
                    Margin="0,0,10,10"
                    Click="Next_Click"/>
            <Button Content="Cancel"
                    Height="35"
                    Width="120"
                    VerticalAlignment="Bottom" 
                    Margin="10,0,0,10"
                    Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>

